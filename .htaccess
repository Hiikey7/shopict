DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Files for search engines and AI assistants, written from the database.
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^sitemap-(pages|products|guides)\.xml$ sitemap.php?part=$1 [L,QSA]
  RewriteRule ^llms\.txt$ llms.php [L]
  RewriteRule ^google-merchant-feed\.xml$ feed.php [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Product pages: /samsung-essential-monitor-p369 → product.php?id=369
  RewriteRule ^([a-z0-9-]+-)?p([0-9]+)/?$ product.php?id=$2 [L,QSA]
  # Buying guides: /buying-guides and /how-much-ram-do-you-need-g3
  RewriteRule ^about/?$ about.php [L,QSA]
  RewriteRule ^buying-guides/?$ blog.php [L,QSA]
  RewriteRule ^([a-z0-9-]+-)?g([0-9]+)/?$ post.php?id=$2 [L,QSA]
  # Category and brand pages: /laptops, /business-laptops, /hp
  RewriteRule ^([a-z0-9-]+)/?$ shop.php?seg=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Private pages stay out of search results.
  <FilesMatch "^(cart|checkout|wishlist|order)\.php$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(gif|jpe?g|png|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(eot|otf|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

<Files "config.php">
  Require all denied
</Files>
